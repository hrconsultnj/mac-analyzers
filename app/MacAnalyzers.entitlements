<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Applied ONLY to hardened-runtime builds (scripts/package.sh, when a
  Developer ID identity is used). The one protection the app needs lifted:
  it asks other apps to quit, which under the hardened runtime is denied
  without this — silently, with no prompt.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
